@model MOM_PROJECT.Models.MeetingMemberModel

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>@(Model.MeetingMemberID == 0 ? "Add Meeting Member" : "Edit Meeting Member")</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
body{
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  font-family: "Inter", sans-serif;
}
.page-title{font-size:28px;font-weight:700;}
.page-subtitle{color:#6b7280;}
.card{
  border:none;
  border-radius:18px;
  box-shadow:0 15px 40px rgba(79,70,229,0.12);
  max-width:900px;
  margin:auto;
}
.card-header{
  background:linear-gradient(135deg,#6366f1,#7c3aed);
  color:#fff;
  font-weight:600;
  padding:16px 24px;
}
.card-body{padding:30px;}
.form-label{font-weight:500;color:#1e1b4b;}
.form-control,.form-select{
  border-radius:12px;
  padding:12px 14px;
}
.form-control:focus,.form-select:focus{
  box-shadow:0 0 0 0.15rem rgba(79,70,229,0.25);
  border-color:#6366f1;
}
.btn-primary{
  background:linear-gradient(135deg,#4f46e5,#6366f1);
  border:none;
  border-radius:999px;
  padding:10px 24px;
}
.btn-secondary{border-radius:999px;}
</style>
</head>

<body>

<div class="container-fluid mt-4">

  <!-- PAGE TITLE -->
  <div class="mb-4">
    <div class="page-title">
      @(Model.MeetingMemberID == 0 ? "Meeting Member" : "Edit Meeting Member")
    </div>
    <div class="page-subtitle">Add or update meeting member details</div>
  </div>

  <!-- CARD -->
  <div class="card">
    <div class="card-header">
      @(Model.MeetingMemberID == 0 ? "👤 Meeting Member Details" : "✏️ Meeting Member Details")
    </div>

    <div class="card-body">

      <form asp-action="MeetingMemberSave" method="post">

        <input type="hidden" asp-for="MeetingMemberID" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">

          <!-- MEETING -->
          <div class="col-md-6">
            <label class="form-label">Meeting</label>

            @if (Model.MeetingMemberID == 0)
            {
              <select asp-for="MeetingID"
                      asp-items="Model.MeetingList"
                      class="form-select">
                <option value="">-- Select Meeting --</option>
              </select>
            }
            else
            {
              <select asp-for="MeetingID"
                      asp-items="Model.MeetingList"
                      class="form-select"
                      disabled></select>
              <input type="hidden" asp-for="MeetingID" />
            }

            <span asp-validation-for="MeetingID" class="text-danger"></span>
          </div>

          <!-- STAFF -->
          <div class="col-md-6">
            <label class="form-label">Staff</label>

            @if (Model.MeetingMemberID == 0)
            {
              <select asp-for="StaffID"
                      asp-items="Model.StaffList"
                      class="form-select">
                <option value="">-- Select Staff --</option>
              </select>
            }
            else
            {
              <select asp-for="StaffID"
                      asp-items="Model.StaffList"
                      class="form-select"
                      disabled></select>
              <input type="hidden" asp-for="StaffID" />
            }

            <span asp-validation-for="StaffID" class="text-danger"></span>
          </div>

          <!-- STATUS -->
          <div class="col-md-6">
            <label class="form-label">Is Present</label>
            <select asp-for="IsPresent" class="form-select">
              <option value="">-- Select --</option>
              <option value="true">Present</option>
              <option value="false">Absent</option>
            </select>
          </div>

          <!-- REMARKS -->
          <div class="col-md-6">
            <label class="form-label">Remarks</label>
            <input asp-for="Remarks" class="form-control" />
          </div>

        </div>

        <!-- ACTION BUTTONS -->
        <div class="mt-4 text-end">
          <a asp-action="MeetingMemberList"
             class="btn btn-secondary">
            ← Back to List
          </a>

          <button type="submit" class="btn btn-primary ms-2">
            ✔ @(Model.MeetingMemberID == 0 ? "Save Member" : "Update Member")
          </button>
        </div>

      </form>

    </div>
  </div>

</div>

</body>
</html>
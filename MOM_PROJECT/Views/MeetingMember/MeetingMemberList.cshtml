@model List<MOM_PROJECT.Models.MeetingMemberModel>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>MOM – Meeting Member List</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />

<style>
body {
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  font-family: "Inter", sans-serif;
}

.card {
  border: none;
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 15px 40px rgba(79, 70, 229, 0.12);
}

.card-body {
  padding: 28px;
}

/* SAME TABLE STYLE AS MEETING TYPE */
.table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 12px;
}

.table thead th,
.table tbody td {
  padding: 16px 18px;
  vertical-align: middle;
  font-size: 14px;
}

.table thead th {
  background: #eef2ff;
  font-weight: 600;
  color: #3730a3;
}

.table tbody tr {
  background: #ffffff;
  transition: 0.25s ease;
}

.table tbody tr:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 30px rgba(79, 70, 229, 0.18);
}

/* CENTER REQUIRED COLUMNS */
.table thead th:nth-child(1),
.table tbody td:nth-child(1),
.table thead th:nth-child(2),
.table tbody td:nth-child(2),
.table thead th:nth-child(4),
.table tbody td:nth-child(4) {
  text-align: center;
}

/* STATUS BADGES */
.badge-present {
  background: #dcfce7;
  color: #166534;
  padding: 6px 14px;
  border-radius: 999px;
  font-weight: 500;
}

.badge-absent {
  background: #fee2e2;
  color: #991b1b;
  padding: 6px 14px;
  border-radius: 999px;
  font-weight: 500;
}

/* ACTION BUTTONS */
.action-btns {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.btn-outline-primary {
  border-color: #6366f1;
  color: #4f46e5;
}

.btn-outline-primary:hover {
  background: #4f46e5;
  color: #ffffff;
}

.btn-outline-danger {
  border-color: #ef4444;
  color: #dc2626;
}

.btn-outline-danger:hover {
  background: #dc2626;
  color: #ffffff;
}
</style>
</head>

<body>

<div class="container-fluid mt-4">
  <div class="card">
    <div class="card-body">

      @if (TempData["SuccessMessage"] != null)
      {
        <div class="alert alert-success alert-dismissible fade show">
          @TempData["SuccessMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      }

      @if (TempData["ErrorMessage"] != null)
      {
        <div class="alert alert-danger alert-dismissible fade show">
          @TempData["ErrorMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      }

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">MOM – Meeting Member List</h5>

        <a asp-controller="MeetingMember"
           asp-action="MeetingMemberAddEdit"
           class="btn btn-primary rounded-pill px-4">
          + Add Member
        </a>
      </div>

      <table class="table datatable">
        <thead>
          <tr>
            <th>Member ID</th>
            <th>Status</th>
            <th>Remarks</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
        @if (Model != null && Model.Count > 0)
        {
          foreach (var item in Model)
          {
            <tr>
              <td>@item.MeetingMemberID</td>

              <td>
                @if (item.IsPresent == true)
                {
                  <span class="badge-present">Present</span>
                }
                else
                {
                  <span class="badge-absent">Absent</span>
                }
              </td>

              <td>
                @(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)
              </td>

              <td>
                <div class="action-btns">
                  <a asp-action="MeetingMemberAddEdit"
                     asp-controller="MeetingMember"
                     asp-route-id="@item.MeetingMemberID"
                     class="btn btn-sm btn-outline-primary rounded-pill">
                    Edit
                  </a>

                  <a asp-action="DeleteMeetingMember"
                     asp-controller="MeetingMember"
                     asp-route-id="@item.MeetingMemberID"
                     class="btn btn-sm btn-outline-danger rounded-pill"
                     onclick="return confirm('Delete this member?');">
                    Delete
                  </a>
                </div>
              </td>
            </tr>
          }
        }
        else
        {
          <tr>
            <td colspan="4" class="text-center text-muted">
              No records found
            </td>
          </tr>
        }
        </tbody>
      </table>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest"></script>
<script>
  new simpleDatatables.DataTable(".datatable");
</script>

</body>
</html>
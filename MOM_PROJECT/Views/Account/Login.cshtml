@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MOM System | Sign In</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Inter", sans-serif;
  min-height: 100vh;
  background: #f1f5f9;          /* light neutral — not dark */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.login-wrapper {
  display: flex;
  width: 100%;
  max-width: 900px;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  animation: fadeIn 0.4s ease;
}
@@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Left panel — brand accent */
.login-left {
  flex: 1;
  background: linear-gradient(145deg, #6366f1, #818cf8, #a78bfa);
  padding: 56px 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: #fff;
}
.brand-logo {
  width: 60px; height: 60px;
  background: rgba(255,255,255,0.2);
  border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  font-size: 26px;
  margin-bottom: 28px;
  border: 1.5px solid rgba(255,255,255,0.3);
}
.login-left h1 { font-size: 28px; font-weight: 800; line-height: 1.2; margin-bottom: 12px; }
.login-left p  { font-size: 14px; opacity: 0.8; line-height: 1.6; }
.feature-list  { margin-top: 32px; }
.feature-item  {
  display: flex; align-items: center; gap: 10px;
  font-size: 13px; margin-bottom: 14px; opacity: 0.9;
}
.feature-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: rgba(255,255,255,0.7);
  flex-shrink: 0;
}

/* Right panel — form */
.login-right {
  flex: 1;
  background: #fff;
  padding: 56px 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.login-right h2 { font-size: 22px; font-weight: 800; color: #1f2937; margin-bottom: 6px; }
.login-right .sub { font-size: 14px; color: #9ca3af; margin-bottom: 32px; }

.form-group { margin-bottom: 20px; }
.form-group label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #6b7280;
  margin-bottom: 7px;
}
.input-wrap { position: relative; }
.input-icon {
  position: absolute; left: 14px; top: 50%;
  transform: translateY(-50%); font-size: 15px; color: #d1d5db;
  pointer-events: none;
}
.form-group input {
  width: 100%;
  padding: 13px 14px 13px 42px;
  border-radius: 10px;
  border: 1.5px solid #e5e7eb;
  font-size: 14px;
  font-family: "Inter", sans-serif;
  background: #fff;
  color: #374151;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.form-group input:focus {
  outline: none;
  border-color: #818cf8;
  box-shadow: 0 0 0 3px rgba(129,140,248,0.15);
}

.row-options {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 24px; font-size: 13px;
}
.row-options label { display: flex; align-items: center; gap: 6px; color: #6b7280; cursor: pointer; }
.row-options a { color: #6366f1; font-weight: 600; text-decoration: none; }

.btn-signin {
  width: 100%;
  padding: 14px;
  border: none; border-radius: 10px;
  font-size: 15px; font-weight: 700;
  color: #fff; font-family: "Inter", sans-serif;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
  box-shadow: 0 4px 14px rgba(99,102,241,0.30);
}
.btn-signin:hover { opacity: 0.88; transform: translateY(-1px); }

.signup-link {
  margin-top: 24px; text-align: center;
  font-size: 14px; color: #9ca3af;
}
.signup-link a { color: #6366f1; font-weight: 700; text-decoration: none; }

@@media (max-width: 640px) {
  .login-wrapper { flex-direction: column; }
  .login-left { padding: 36px; }
  .login-right { padding: 36px; }
}
</style>
</head>
<body>

<div class="login-wrapper">

  <!-- Left brand panel -->
  <div class="login-left">
    <div class="brand-logo">📋</div>
    <h1>Meeting & MOM Management</h1>
    <p>Organise, track and manage all your meetings in one place.</p>
    <div class="feature-list">
      <div class="feature-item"><div class="feature-dot"></div> Manage meetings & attendees</div>
      <div class="feature-item"><div class="feature-dot"></div> Track attendance & reports</div>
      <div class="feature-item"><div class="feature-dot"></div> Department & staff management</div>
      <div class="feature-item"><div class="feature-dot"></div> Export to Excel in one click</div>
    </div>
  </div>

  <!-- Right form panel -->
  <div class="login-right">
    <h2>Welcome back 👋</h2>
    <p class="sub">Sign in to your MOM System account</p>

    <form action="#" onsubmit="return false;">

      <div class="form-group">
        <label>Username</label>
        <div class="input-wrap">
          <span class="input-icon">👤</span>
          <input type="text" placeholder="Enter your username" autocomplete="username" />
        </div>
      </div>

      <div class="form-group">
        <label>Password</label>
        <div class="input-wrap">
          <span class="input-icon">🔒</span>
          <input type="password" placeholder="Enter your password" autocomplete="current-password" />
        </div>
      </div>

      <div class="row-options">
        <label><input type="checkbox"> Remember me</label>
        <a href="#">Forgot password?</a>
      </div>

      <a href="@Url.Action("Index","Home")" style="text-decoration:none;display:block;">
        <button type="button" class="btn-signin">Sign In →</button>
      </a>

    </form>

    <div class="signup-link">
      Don't have an account? <a href="@Url.Action("Register","Account")">Create one →</a>
    </div>
  </div>

</div>

</body>
</html>
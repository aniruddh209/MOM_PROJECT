@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Account | MOM System</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Inter", sans-serif;
  min-height: 100vh;
  background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 50%, #7c3aed 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px 20px;
  position: relative;
  overflow: hidden;
}
body::before {
  content: "";
  position: absolute;
  width: 500px; height: 500px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  top: -150px; left: -150px;
  pointer-events: none;
}
body::after {
  content: "";
  position: absolute;
  width: 350px; height: 350px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  bottom: -100px; right: -80px;
  pointer-events: none;
}

/* Card */
.register-card {
  width: 100%;
  max-width: 760px;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 40px 80px rgba(0,0,0,0.4);
  position: relative;
  z-index: 1;
  animation: slideUp 0.4s ease;
}
@@keyframes slideUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Header */
.card-top {
  background: linear-gradient(135deg, #6366f1, #7c3aed);
  padding: 36px 40px 28px;
  text-align: center;
  color: #fff;
}
.brand-icon {
  width: 64px; height: 64px;
  border-radius: 18px;
  background: rgba(255,255,255,0.18);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 28px;
  margin-bottom: 14px;
  border: 2px solid rgba(255,255,255,0.3);
}
.card-top h1 { font-size: 26px; font-weight: 800; margin-bottom: 6px; }
.card-top p  { font-size: 14px; opacity: 0.8; }

/* Body */
.card-body {
  background: #fff;
  padding: 34px 42px;
}

.section-label {
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: #6366f1;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-label::after {
  content: "";
  flex: 1;
  height: 1.5px;
  background: linear-gradient(to right, #e0e7ff, transparent);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}
.form-group { display: flex; flex-direction: column; }

.form-group label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #1e1b4b;
  margin-bottom: 8px;
}

.input-wrap { position: relative; }
.input-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 15px;
  color: #9ca3af;
  pointer-events: none;
}

input, select {
  width: 100%;
  padding: 12px 14px 12px 42px;
  border-radius: 12px;
  border: 1.5px solid #e5e7eb;
  font-size: 14px;
  font-family: "Inter", sans-serif;
  background: #f8fafc;
  color: #111827;
  transition: border-color 0.2s, box-shadow 0.2s;
  appearance: auto;
}
input:focus, select:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99,102,241,0.18);
  background: #fff;
}
select { padding-left: 42px; }

small {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  color: #9ca3af;
}

.btn-register {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 14px;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  font-family: "Inter", sans-serif;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
  margin-top: 8px;
}
.btn-register:hover { opacity: 0.88; transform: translateY(-1px); }

/* Footer */
.card-footer {
  background: #f8fafc;
  padding: 18px 40px;
  text-align: center;
  border-top: 1px solid #f1f5f9;
  font-size: 14px;
  color: #6b7280;
}
.card-footer a { color: #6366f1; font-weight: 700; text-decoration: none; }
.card-footer a:hover { text-decoration: underline; }

@@media (max-width: 560px) {
  .form-row { grid-template-columns: 1fr; }
  .card-body { padding: 26px 24px; }
}
</style>
</head>
<body>

<div class="register-card">

  <!-- Header -->
  <div class="card-top">
    <div class="brand-icon">📋</div>
    <h1>Create Account</h1>
    <p>Join the MOM System to organise and track meetings efficiently</p>
  </div>

  <!-- Body -->
  <div class="card-body">
    <form action="#" onsubmit="return false;">

      <div class="section-label">Account Information</div>

      <div class="form-row">
        <div class="form-group">
          <label>Username</label>
          <div class="input-wrap">
            <span class="input-icon">👤</span>
            <input type="text" placeholder="Choose a username" autocomplete="username" />
          </div>
          <small>3–50 characters required</small>
        </div>

        <div class="form-group">
          <label>Role</label>
          <div class="input-wrap">
            <span class="input-icon">🎭</span>
            <select>
              <option>Select Role</option>
              <option>Admin</option>
              <option>Member</option>
            </select>
          </div>
        </div>
      </div>

      <div class="section-label">Security</div>

      <div class="form-row">
        <div class="form-group">
          <label>Password</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input type="password" placeholder="Create a password" autocomplete="new-password" />
          </div>
          <small>Minimum 6 characters</small>
        </div>

        <div class="form-group">
          <label>Confirm Password</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input type="password" placeholder="Repeat your password" autocomplete="new-password" />
          </div>
        </div>
      </div>

      <div class="section-label">Link to Staff</div>

      <div class="form-row" style="grid-template-columns:1fr;">
        <div class="form-group">
          <label>Staff Member <span style="color:#9ca3af;font-weight:400;">(Optional)</span></label>
          <div class="input-wrap">
            <span class="input-icon">🏢</span>
            <select>
              <option>Staff Member (Optional)</option>
            </select>
          </div>
          <small>Link to a staff member for better attendance tracking</small>
        </div>
      </div>

      <button type="button" class="btn-register">👤 Create Account</button>

    </form>
  </div>

  <!-- Footer -->
  <div class="card-footer">
    Already have an account?
    <a href="@Url.Action("Login","Account")">Sign in here →</a>
  </div>

</div>

</body>
</html>
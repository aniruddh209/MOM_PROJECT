@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Account | MOM System</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Inter", sans-serif;
  min-height: 100vh;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px 20px;
}

.reg-card {
  width: 100%;
  max-width: 720px;
  background: #fff;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.10);
  animation: fadeIn 0.4s ease;
}
@@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Top banner */
.reg-banner {
  background: linear-gradient(135deg, #6366f1, #818cf8, #a78bfa);
  color: #fff;
  padding: 36px 40px;
  text-align: center;
}
.brand-logo {
  font-size: 32px; margin-bottom: 10px;
}
.reg-banner h1 { font-size: 24px; font-weight: 800; margin-bottom: 6px; }
.reg-banner p  { font-size: 14px; opacity: 0.8; }

/* Body */
.reg-body { padding: 36px 40px; }

.section-label {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.8px; color: #818cf8;
  margin: 0 0 16px;
  display: flex; align-items: center; gap: 10px;
}
.section-label::after {
  content: ""; flex: 1; height: 1px;
  background: linear-gradient(to right, #e5e7ff, transparent);
}

.form-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px;
}
.form-group { display: flex; flex-direction: column; }
.form-group.full { grid-column: 1 / -1; }

.form-group label {
  font-size: 12px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.5px; color: #6b7280; margin-bottom: 7px;
}

.input-wrap { position: relative; }
.input-icon {
  position: absolute; left: 13px; top: 50%;
  transform: translateY(-50%); font-size: 14px; color: #d1d5db;
  pointer-events: none;
}

input, select {
  width: 100%;
  padding: 12px 14px 12px 40px;
  border-radius: 10px;
  border: 1.5px solid #e5e7eb;
  font-size: 14px; font-family: "Inter", sans-serif;
  background: #fff; color: #374151;
  transition: border-color 0.2s, box-shadow 0.2s;
}
input:focus, select:focus {
  outline: none;
  border-color: #818cf8;
  box-shadow: 0 0 0 3px rgba(129,140,248,0.12);
}
select { padding-left: 40px; appearance: auto; }
small {
  display: block; margin-top: 5px;
  font-size: 12px; color: #9ca3af;
}

.btn-register {
  width: 100%;
  padding: 14px; border: none; border-radius: 10px;
  font-size: 15px; font-weight: 700; color: #fff;
  font-family: "Inter", sans-serif;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
  box-shadow: 0 4px 14px rgba(99,102,241,0.28);
  margin-top: 10px;
}
.btn-register:hover { opacity: 0.88; transform: translateY(-1px); }

.login-link {
  text-align: center; margin-top: 22px;
  font-size: 14px; color: #9ca3af;
}
.login-link a { color: #6366f1; font-weight: 700; text-decoration: none; }

@@media (max-width: 540px) {
  .form-row { grid-template-columns: 1fr; }
  .reg-body, .reg-banner { padding: 26px 24px; }
}
</style>
</head>
<body>

<div class="reg-card">

  <!-- Top banner -->
  <div class="reg-banner">
    <div class="brand-logo">📋</div>
    <h1>Create Account</h1>
    <p>Join the MOM System to organise and track meetings efficiently</p>
  </div>

  <!-- Form body -->
  <div class="reg-body">
    <form action="#" onsubmit="return false;">

      <div class="section-label">Account Information</div>

      <div class="form-row">
        <div class="form-group">
          <label>Username</label>
          <div class="input-wrap">
            <span class="input-icon">👤</span>
            <input type="text" placeholder="Choose a username" autocomplete="username" />
          </div>
          <small>3–50 characters required</small>
        </div>

        <div class="form-group">
          <label>Role</label>
          <div class="input-wrap">
            <span class="input-icon">🎭</span>
            <select>
              <option>Select Role</option>
              <option>Admin</option>
              <option>Member</option>
            </select>
          </div>
        </div>
      </div>

      <div class="section-label">Security</div>

      <div class="form-row">
        <div class="form-group">
          <label>Password</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input type="password" placeholder="Create a password" autocomplete="new-password" />
          </div>
          <small>Minimum 6 characters</small>
        </div>

        <div class="form-group">
          <label>Confirm Password</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input type="password" placeholder="Repeat password" autocomplete="new-password" />
          </div>
        </div>
      </div>

      <div class="section-label">Link to Staff</div>

      <div class="form-row">
        <div class="form-group full">
          <label>Staff Member <span style="font-weight:400;text-transform:none;letter-spacing:0;">(Optional)</span></label>
          <div class="input-wrap">
            <span class="input-icon">🏢</span>
            <select>
              <option>Staff Member (Optional)</option>
            </select>
          </div>
          <small>Link to a staff member for better attendance tracking</small>
        </div>
      </div>

      <button type="button" class="btn-register">Create Account →</button>

    </form>

    <div class="login-link">
      Already have an account? <a href="@Url.Action("Login","Account")">Sign in →</a>
    </div>
  </div>

</div>

</body>
</html>
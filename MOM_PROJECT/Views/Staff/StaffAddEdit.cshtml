@model MOM_PROJECT.Models.StaffModel

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Add / Edit Staff</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
body{
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  font-family: "Inter", sans-serif;
}
.page-title{font-size:28px;font-weight:700;}
.page-subtitle{color:#6b7280;}
.card{
  border:none;
  border-radius:18px;
  box-shadow:0 15px 40px rgba(79,70,229,0.12);
  max-width:1000px;
  margin:auto;
}
.card-header{
  background:linear-gradient(135deg,#6366f1,#7c3aed);
  color:#fff;
  font-weight:600;
  padding:16px 24px;
}
.card-body{padding:30px;}
.form-label{font-weight:500;color:#1e1b4b;}
.form-control,.form-select{
  border-radius:12px;
  padding:12px 14px;
}
.btn-primary{
  background:linear-gradient(135deg,#4f46e5,#6366f1);
  border:none;
  border-radius:999px;
  padding:10px 24px;
}
.btn-secondary{border-radius:999px;}
</style>
</head>

<body>

<div class="container-fluid mt-4">

  <div class="mb-4">
    <div class="page-title">Staff</div>
    <div class="page-subtitle">Add or update staff information</div>
  </div>

  <div class="card">
    <div class="card-header">👤 Staff Details</div>

    <div class="card-body">
      <form asp-action="StaffAddEdit" method="post">

        <input asp-for="StaffID" type="hidden" />

        <div class="row g-3">

          <div class="col-md-4">
            <label class="form-label">Staff ID</label>
            <input class="form-control"
                   value="@(Model.StaffID == 0 ? "Auto" : Model.StaffID)"
                   disabled />
          </div>

          <div class="col-md-4">
            <label class="form-label">Staff Name</label>
            <input asp-for="StaffName" class="form-control" />
          </div>

          <div class="col-md-4">
            <label class="form-label">Mobile Number</label>
            <input asp-for="MobileNo" class="form-control" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Email Address</label>
            <input asp-for="EmailAddress" class="form-control" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Department</label>
            <select asp-for="DepartmentID"
                    asp-items="Model.DepartmentList"
                    class="form-select">
              <option value="">-- Select Department --</option>
            </select>
          </div>

          <div class="col-md-12">
            <label class="form-label">Remarks</label>
            <input asp-for="Remarks" class="form-control" />
          </div>

        </div>

        <div class="mt-4 text-end">
          <a asp-action="StaffList" class="btn btn-secondary">
            ← Back to List
          </a>
          <button type="submit" class="btn btn-primary ms-2">
            @(Model.StaffID == 0 ? "✔ Save Staff" : "✔ Update Staff")
          </button>
        </div>

      </form>
    </div>
  </div>

</div>

</body>
</html>
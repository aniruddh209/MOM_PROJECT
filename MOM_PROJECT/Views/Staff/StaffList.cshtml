@model List<MOM_PROJECT.Models.StaffModel>

<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>MOM – Staff List</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet">

<style>
/* --- your CSS unchanged --- */
body{background:linear-gradient(135deg,#eef2ff,#f8fafc);font-family:"Inter",sans-serif;}
.card{border:none;border-radius:18px;background:#fff;box-shadow:0 15px 40px rgba(79,70,229,.12);}
.card-body{padding:28px;}
.table{width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0 12px;}
.table thead th,.table tbody td{padding:16px 18px;vertical-align:middle;text-align:left;font-size:14px;}
.table thead th{background:#eef2ff;font-weight:600;color:#3730a3;}
.table tbody tr{background:#fff;transition:.25s ease;}
.table tbody tr:hover{box-shadow:0 10px 30px rgba(79,70,229,.18);transform:translateY(-1px);}
.table thead th:last-child,.table tbody td:last-child{text-align:center;}
.table th:nth-child(1),.table td:nth-child(1){width:20%;}
.table th:nth-child(2),.table td:nth-child(2){width:15%;}
.table th:nth-child(3),.table td:nth-child(3){width:25%;}
.table th:nth-child(4),.table td:nth-child(4){width:25%;}
.table th:nth-child(5),.table td:nth-child(5){width:15%;}
.action-btns{display:inline-flex;gap:10px;min-width:140px;justify-content:center;}
.btn-outline-primary{border-color:#6366f1;color:#4f46e5;}
.btn-outline-primary:hover{background:#4f46e5;color:#fff;}
.btn-outline-danger{border-color:#ef4444;color:#dc2626;}
.btn-outline-danger:hover{background:#dc2626;color:#fff;}
</style>
</head>

<body>

<div class="container-fluid mt-4">
<div class="card">
<div class="card-body">

<div class="d-flex justify-content-between align-items-center mb-3">
<h5 class="mb-0">MOM – Staff List</h5>
<a asp-action="StaffAddEdit" asp-controller="Staff"
class="btn btn-primary rounded-pill px-4">+ Add Staff</a>
</div>

<table class="table datatable">
<thead>
<tr>
<th>Staff Name</th>
<th>Mobile No</th>
<th>Email Address</th>
<th>Remarks</th>
<th>Action</th>
</tr>
</thead>

<tbody>

@if (Model != null && Model.Count > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.StaffName</td>
            <td>@item.MobileNo</td>
            <td>@item.EmailAddress</td>
            <td>@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</td>
            <td>
                <div class="action-btns">
                    <a asp-action="StaffAddEdit" asp-controller="Staff"
                       class="btn btn-sm btn-outline-primary rounded-pill">
                       Edit
                    </a>
                    <a class="btn btn-sm btn-outline-danger rounded-pill"
                       onclick="return confirm('Delete this staff?');">
                       Delete
                    </a>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="5" class="text-center text-muted">
            No records found
        </td>
    </tr>
}

</tbody>
</table>

</div>
</div>
</div>

</body>
</html>
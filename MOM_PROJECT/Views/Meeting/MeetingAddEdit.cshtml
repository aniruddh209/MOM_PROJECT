@model MOM_PROJECT.Models.MeetingModel

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>@(Model.MeetingID == 0 ? "Add Meeting" : "Edit Meeting")</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
body{
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  font-family: "Inter", sans-serif;
}
.page-title{font-size:28px;font-weight:700;}
.page-subtitle{color:#6b7280;}
.card{
  border:none;
  border-radius:18px;
  box-shadow:0 15px 40px rgba(79,70,229,0.12);
  max-width:900px;
  margin:auto;
}
.card-header{
  background:linear-gradient(135deg,#6366f1,#7c3aed);
  color:#fff;
  font-weight:600;
  padding:16px 24px;
}
.card-body{padding:30px;}
.form-label{font-weight:500;color:#1e1b4b;}
.form-control,.form-select{
  border-radius:12px;
  padding:12px 14px;
}
.form-control:focus,.form-select:focus{
  box-shadow:0 0 0 0.15rem rgba(79,70,229,0.25);
  border-color:#6366f1;
}
.btn-primary{
  background:linear-gradient(135deg,#4f46e5,#6366f1);
  border:none;
  border-radius:999px;
  padding:10px 24px;
}
.btn-secondary{border-radius:999px;}
.cancel-field{display:none;}
</style>
</head>

<body>

<div class="container-fluid mt-4">

  <!-- PAGE TITLE -->
  <div class="mb-4">
    <div class="page-title">
      @(Model.MeetingID == 0 ? "Meeting" : "Edit Meeting")
    </div>
    <div class="page-subtitle">Add or update meeting details</div>
  </div>

  <!-- CARD -->
  <div class="card">
    <div class="card-header">
      @(Model.MeetingID == 0 ? "➕ Meeting Details" : "✏️ Meeting Details")
    </div>

    <div class="card-body">

      <form asp-action="MeetingAddEdit"
            asp-controller="Meeting"
            method="post">

        <input type="hidden" asp-for="MeetingID" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">

          <!-- MEETING ID -->
          <div class="col-md-4">
            <label class="form-label">Meeting ID</label>
            <input class="form-control"
                   value="@(Model.MeetingID == 0 ? "Auto" : Model.MeetingID)"
                   disabled />
          </div>

          <!-- DESCRIPTION -->
          <div class="col-md-8">
            <label class="form-label">Meeting Description</label>
            <input asp-for="MeetingDescription"
                   class="form-control"
                   required />
          </div>

          <!-- DATE -->
          <div class="col-md-6">
            <label class="form-label">Meeting Date</label>
            <input asp-for="MeetingDate"
                   type="date"
                   class="form-control"
                   required />
          </div>

          <!-- DOCUMENT -->
          <div class="col-md-6">
            <label class="form-label">Document Path</label>
            <input asp-for="DocumentPath"
                   class="form-control" />
          </div>

          <!-- DEPARTMENT -->
          <div class="col-md-4">
            <label class="form-label">Department</label>
            <select asp-for="DepartmentID"
                    class="form-select"
                    required>
              <option value="">-- Select Department --</option>
              <option value="1">Department 1</option>
              <option value="2">Department 2</option>
            </select>
          </div>

          <!-- MEETING TYPE -->
          <div class="col-md-4">
            <label class="form-label">Meeting Type</label>
            <select asp-for="MeetingTypeID"
                    class="form-select"
                    required>
              <option value="">-- Select Type --</option>
              <option value="1">Type 1</option>
              <option value="2">Type 2</option>
            </select>
          </div>

          <!-- VENUE -->
          <div class="col-md-4">
            <label class="form-label">Meeting Venue</label>
            <select asp-for="MeetingVenueID"
                    class="form-select"
                    required>
              <option value="">-- Select Venue --</option>
              <option value="1">Venue 1</option>
              <option value="2">Venue 2</option>
            </select>
          </div>

          <!-- IS CANCELLED -->
          <div class="col-md-4">
            <label class="form-label">Is Cancelled</label>
            <select asp-for="IsCancelled"
                    class="form-select"
                    id="IsCancelled">
              <option value="false">No</option>
              <option value="true">Yes</option>
            </select>
          </div>

          <!-- CANCEL DATE -->
          <div class="col-md-4 cancel-field">
            <label class="form-label">Cancellation Date</label>
            <input asp-for="CancellationDateTime"
                   type="datetime-local"
                   class="form-control" />
          </div>

          <!-- CANCEL REASON -->
          <div class="col-md-4 cancel-field">
            <label class="form-label">Cancellation Reason</label>
            <input asp-for="CancellationReason"
                   class="form-control" />
          </div>

        </div>

        <!-- ACTION BUTTONS -->
        <div class="mt-4 text-end">
          <a asp-action="MeetingList"
             asp-controller="Meeting"
             class="btn btn-secondary">
            ← Back to List
          </a>

          <button type="submit"
                  class="btn btn-primary ms-2">
            ✔ @(Model.MeetingID == 0 ? "Save Meeting" : "Update Meeting")
          </button>
        </div>

      </form>

    </div>
  </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
function toggleCancel(){
  if ($('#IsCancelled').val() === "true")
    $('.cancel-field').show();
  else
    $('.cancel-field').hide();
}
toggleCancel();
$('#IsCancelled').change(toggleCancel);
</script>

</body>
</html>
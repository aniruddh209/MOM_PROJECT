@model List<MOM_PROJECT.Models.MeetingModel>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>MOM – Meeting List</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />

<style>
body {
  background: linear-gradient(135deg, #eef2ff, #f8fafc);
  font-family: "Inter", sans-serif;
}

.card {
  border: none;
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 15px 40px rgba(79, 70, 229, 0.12);
}

.card-body { padding: 28px; }

.table {
  width: 100%;
  table-layout: fixed;
  border-collapse: separate;
  border-spacing: 0 12px;
}

.table thead th,
.table tbody td {
  padding: 16px 18px;
  vertical-align: middle;
  font-size: 14px;
}

.table thead th {
  background: #eef2ff;
  font-weight: 600;
  color: #3730a3;
}

.table thead th.text-left { text-align: left; }
.table thead th.text-center { text-align: center; }

.table tbody tr {
  background: #ffffff;
  transition: 0.25s ease;
}

.table tbody tr:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 30px rgba(79, 70, 229, 0.18);
}

/* BADGES */
.badge-active {
  background: #dcfce7;
  color: #166534;
  padding: 6px 14px;
  border-radius: 999px;
}

.badge-canceled {
  background: #fee2e2;
  color: #991b1b;
  padding: 6px 14px;
  border-radius: 999px;
}

/* ACTION BUTTONS */
.action-btns {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

/* ✅ CANCELLATION INFO FIX */
.cancel-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1.4;
}

.cancel-date {
  font-size: 13px;
  font-weight: 500;
}

.cancel-reason {
  font-size: 13px;
  color: #6b7280;
}

.cancel-none {
  text-align: center;
  color: #9ca3af;
}

.btn-outline-primary {
  border-color: #6366f1;
  color: #4f46e5;
}
.btn-outline-primary:hover {
  background: #4f46e5;
  color: #ffffff;
}

.btn-outline-danger {
  border-color: #ef4444;
  color: #dc2626;
}
.btn-outline-danger:hover {
  background: #dc2626;
  color: #ffffff;
}
</style>
</head>

<body>

<div class="container-fluid mt-4">
  <div class="card">
    <div class="card-body">

      @if (TempData["SuccessMessage"] != null)
      {
        <div class="alert alert-success alert-dismissible fade show">
          @TempData["SuccessMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      }

      @if (TempData["ErrorMessage"] != null)
      {
        <div class="alert alert-danger alert-dismissible fade show">
          @TempData["ErrorMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      }

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">MOM – Meeting List</h5>
        <a asp-action="MeetingAddEdit"
           asp-controller="Meeting"
           class="btn btn-primary rounded-pill px-4">
          + Add Meeting
        </a>
      </div>

      <table class="table datatable">
        <thead>
          <tr>
            <th class="text-left">Description</th>
            <th class="text-center">Date</th>
            <th class="text-center">Cancelled</th>
            <th class="text-left">Cancellation Info</th>
            <th class="text-center">Action</th>
          </tr>
        </thead>

        <tbody>
        @if (Model != null && Model.Count > 0)
        {
          foreach (var item in Model)
          {
            <tr>
              <td>@(string.IsNullOrEmpty(item.MeetingDescription) ? "-" : item.MeetingDescription)</td>

              <td class="text-center">
                @(item.MeetingDate.HasValue
                    ? item.MeetingDate.Value.ToString("dd/MM/yyyy")
                    : "-")
              </td>

              <td class="text-center">
                @if (item.IsCancelled == true)
                {
                  <span class="badge-canceled">Yes</span>
                }
                else
                {
                  <span class="badge-active">No</span>
                }
              </td>

              <!-- ✅ FIXED CANCELLATION INFO -->
              <td>
                @if (item.IsCancelled == true)
                {
                  <div class="cancel-info">
                    <span class="cancel-date">
                      @(item.CancellationDateTime.HasValue
                        ? item.CancellationDateTime.Value.ToString("dd/MM/yyyy hh:mm tt")
                        : "-")
                    </span>
                    <span class="cancel-reason">
                      @(string.IsNullOrEmpty(item.CancellationReason) ? "-" : item.CancellationReason)
                    </span>
                  </div>
                }
                else
                {
                  <div class="cancel-none">-</div>
                }
              </td>

              <td class="text-center align-middle">
                <div class="action-btns">
                  <a asp-action="MeetingAddEdit"
                     asp-controller="Meeting"
                     asp-route-id="@item.MeetingID"
                     class="btn btn-sm btn-outline-primary rounded-pill">
                    Edit
                  </a>

                  <a asp-action="DeleteMeeting"
                     asp-controller="Meeting"
                     asp-route-id="@item.MeetingID"
                     class="btn btn-sm btn-outline-danger rounded-pill"
                     onclick="return confirm('Delete this meeting?');">
                    Delete
                  </a>
                </div>
              </td>
            </tr>
          }
        }
        else
        {
          <tr>
            <td colspan="5" class="text-center text-muted">
              No records found
            </td>
          </tr>
        }
        </tbody>
      </table>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest"></script>
<script>
new simpleDatatables.DataTable(".datatable");
</script>

</body>
</html>
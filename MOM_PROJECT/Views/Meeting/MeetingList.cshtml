@model List<MOM_PROJECT.Models.MeetingModel>

@{
    ViewData["Title"] = "Meeting List";
    Layout = "_Layout";
}

<style>
/* ── Page Header ─────────────────────────────────── */
.page-title   { font-size: 26px; font-weight: 700; color: #1e1b4b; }
.page-subtitle{ color: #6b7280; font-size: 14px; }

/* ── Card ─────────────────────────────────────────── */
.mom-card {
  border: none;
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 15px 40px rgba(79, 70, 229, 0.10);
  overflow: hidden;
}

/* ── Card top bar ────────────────────────────────── */
.mom-card-header {
  background: linear-gradient(135deg, #6366f1, #7c3aed);
  color: #fff;
  padding: 18px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mom-card-header h5 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0.3px;
}
.btn-add-meeting {
  background: rgba(255,255,255,0.18);
  border: 1.5px solid rgba(255,255,255,0.5);
  color: #fff;
  border-radius: 999px;
  padding: 6px 18px;
  font-size: 13px;
  font-weight: 600;
  transition: background 0.2s;
  text-decoration: none;
}
.btn-add-meeting:hover {
  background: rgba(255,255,255,0.30);
  color: #fff;
}

/* ── Table ───────────────────────────────────────── */
.mom-table-wrap { padding: 24px; }

.mom-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 10px;
  table-layout: fixed;
}

.mom-table thead th {
  background: #eef2ff;
  color: #3730a3;
  font-weight: 700;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  padding: 14px 18px;
}
.mom-table thead th:first-child { border-radius: 10px 0 0 10px; }
.mom-table thead th:last-child  { border-radius: 0 10px 10px 0; }

.mom-table tbody tr {
  background: #fff;
  box-shadow: 0 2px 8px rgba(79,70,229,0.07);
  transition: transform 0.2s, box-shadow 0.2s;
}
.mom-table tbody tr:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(79,70,229,0.15);
}
.mom-table tbody td {
  padding: 15px 18px;
  vertical-align: middle;
  font-size: 14px;
  color: #374151;
  border: none;
}
.mom-table tbody td:first-child { border-radius: 10px 0 0 10px; }
.mom-table tbody td:last-child  { border-radius: 0 10px 10px 0; }

/* ── Badges ───────────────────────────────────────── */
.pill-active {
  background: #dcfce7;
  color: #166534;
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}
.pill-canceled {
  background: #fee2e2;
  color: #991b1b;
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

/* ── Action Buttons ──────────────────────────────── */
.action-group {
  display: inline-flex;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: center;
}
.action-group .btn {
  border-radius: 999px;
  font-size: 12px;
  padding: 5px 14px;
  font-weight: 600;
  transition: all 0.2s;
}
.btn-members {
  border: 1.5px solid #22c55e;
  color: #16a34a;
  background: #f0fdf4;
}
.btn-members:hover { background: #22c55e; color: #fff; }
.btn-edit-row {
  border: 1.5px solid #6366f1;
  color: #4f46e5;
  background: #eef2ff;
}
.btn-edit-row:hover { background: #6366f1; color: #fff; }
.btn-delete-row {
  border: 1.5px solid #f87171;
  color: #dc2626;
  background: #fff5f5;
}
.btn-delete-row:hover { background: #ef4444; color: #fff; }
</style>

<div class="container-fluid px-4 mt-4">

  <!-- Page Header -->
  <div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
      <div class="page-title">📋 Meeting List</div>
      <div class="page-subtitle">Manage all scheduled and past meetings</div>
    </div>
  </div>

  <!-- Main Card -->
  <div class="mom-card">

    <!-- Card Header -->
    <div class="mom-card-header">
      <h5>🗓 All Meetings</h5>
      <a asp-action="MeetingAddEdit" asp-controller="Meeting" class="btn-add-meeting">
        + Add Meeting
      </a>
    </div>

    <!-- Table -->
    <div class="mom-table-wrap">
      <table class="mom-table datatable">
        <thead>
          <tr>
            <th>Description</th>
            <th class="text-center">Date</th>
            <th class="text-center">Cancelled</th>
            <th>Cancellation Info</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (Model != null && Model.Count > 0)
          {
            foreach (var item in Model)
            {
              <tr>
                <!-- Description -->
                <td>
                  @(string.IsNullOrWhiteSpace(item.MeetingDescription) ? "-" : item.MeetingDescription)
                </td>

                <!-- Date -->
                <td class="text-center">
                  @(item.MeetingDate.HasValue
                      ? item.MeetingDate.Value.ToString("dd/MM/yyyy")
                      : "-")
                </td>

                <!-- Cancelled Badge -->
                <td class="text-center">
                  @if (item.IsCancelled == true)
                  {
                    <span class="pill-canceled">Yes</span>
                  }
                  else
                  {
                    <span class="pill-active">No</span>
                  }
                </td>

                <!-- Cancellation Info -->
                <td>
                  @if (item.IsCancelled == true)
                  {
                    <div style="font-size:13px;">
                      @(item.CancellationDateTime.HasValue
                          ? item.CancellationDateTime.Value.ToString("dd/MM/yyyy hh:mm tt")
                          : "-")
                    </div>
                    <small class="text-muted">
                      @(string.IsNullOrWhiteSpace(item.CancellationReason) ? "-" : item.CancellationReason)
                    </small>
                  }
                  else
                  {
                    <span class="text-muted">—</span>
                  }
                </td>

                <!-- Actions -->
                <td class="text-center">
                  <div class="action-group">
                    <a asp-controller="MeetingMember"
                       asp-action="MeetingMemberList"
                       asp-route-meetingId="@item.MeetingID"
                       class="btn btn-members">
                      Members
                    </a>
                    <a asp-controller="Meeting"
                       asp-action="MeetingAddEdit"
                       asp-route-id="@item.MeetingID"
                       class="btn btn-edit-row">
                      Edit
                    </a>
                    <a asp-controller="Meeting"
                       asp-action="DeleteMeeting"
                       asp-route-id="@item.MeetingID"
                       class="btn btn-delete-row"
                       onclick="return confirm('Delete this meeting?');">
                      Delete
                    </a>
                  </div>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5" class="text-center text-muted py-4">
                <i class="bi bi-calendar-x fs-2 d-block mb-2 opacity-50"></i>
                No meetings found
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest"></script>
<script>
  new simpleDatatables.DataTable(".datatable");
</script>
@model MOM_PROJECT.Models.MeetingVenueModel

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Add / Edit Meeting Venue</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
body{
  background: linear-gradient(135deg,#eef2ff,#f8fafc);
  font-family: "Inter", sans-serif;
}
.page-title{font-size:28px;font-weight:700;}
.page-subtitle{color:#6b7280;}
.venue-card{
  background:#ffffff;
  border-radius:18px;
  box-shadow:0 15px 40px rgba(79,70,229,0.15);
  max-width:900px;
  margin:auto;
}
.venue-card-header{
  background:linear-gradient(135deg,#6366f1,#7c3aed);
  color:#fff;
  padding:18px 24px;
  font-size:18px;
  font-weight:600;
}
.venue-card-body{padding:30px;}
.form-control{
  border-radius:12px;
  padding:14px 16px;
}
.btn-primary{
  background:linear-gradient(135deg,#4f46e5,#6366f1);
  border:none;
  border-radius:999px;
  padding:10px 26px;
}
.btn-secondary{border-radius:999px;}
</style>
</head>

<body>

<div class="container-fluid mt-4">

  <div class="mb-4">
    <div class="page-title">Meeting Venue</div>
    <div class="page-subtitle">Add or update venue</div>
  </div>

  <div class="venue-card">

    <div class="venue-card-header">
      📍 Meeting Venue Details
    </div>

    <div class="venue-card-body">

      <!-- ✅ FIXED FORM -->
      <form asp-controller="MeetingVenue"
            asp-action="MeetingVenueAddEdit"
            method="post">

        <input type="hidden" asp-for="MeetingVenueID" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Meeting Venue Name</label>

          <input asp-for="MeetingVenueName"
                 class="form-control"
                 placeholder="Enter meeting venue name" />

          <span asp-validation-for="MeetingVenueName" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-4">
          <a asp-action="MeetingVenueList"
             class="btn btn-secondary">
            ← Back
          </a>

          <button type="submit" class="btn btn-primary">
            ✔ Save Venue
          </button>
        </div>

      </form>

    </div>
  </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
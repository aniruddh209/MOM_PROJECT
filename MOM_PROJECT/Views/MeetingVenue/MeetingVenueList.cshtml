@model List<MOM_PROJECT.Models.MeetingVenueModel>

@{
    ViewData["Title"] = "Meeting Venues";
    Layout = "_Layout";
}

<div class="container-fluid px-4 mt-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <div class="mom-page-title">Meeting Venues</div>
      <div class="mom-page-subtitle">Manage meeting rooms and virtual meeting locations</div>
    </div>
    <a asp-action="MeetingVenueAddEdit" asp-controller="MeetingVenue"
       class="mom-btn-save" style="display:inline-block;">
      + Add Venue
    </a>
  </div>

  <!-- Alerts -->
  @if (TempData["SuccessMessage"] != null)
  {
    <div class="mom-alert-success mb-3">✅ @TempData["SuccessMessage"]</div>
  }
  @if (TempData["ErrorMessage"] != null)
  {
    <div class="mom-alert-danger mb-3">⚠️ @TempData["ErrorMessage"]</div>
  }

  <!-- Search bar -->
  <div class="mom-card" style="border-radius:16px;">
    <div class="mom-card-body" style="padding:16px 24px;">
      <div class="d-flex justify-content-between align-items-center gap-3">
        <input type="text" id="venueSearch" class="form-control mom-control w-50"
               placeholder="🔍 Search venues..." />
        <div class="mom-page-subtitle">
          Total Venues: <strong style="color:#1e1b4b;">@(Model?.Count ?? 0)</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Venue Grid -->
  @if (Model != null && Model.Count > 0)
  {
    <div class="row g-4" id="venueContainer">
      @foreach (var item in Model)
      {
        <div class="col-lg-4 col-md-6 venue-item">
          <div class="mom-venue-card">

            <!-- Card Header -->
            <div class="mom-venue-header">
              <div>
                <div style="font-weight:700;font-size:16px;font-family:Inter,sans-serif;">
                  @item.MeetingVenueName
                </div>
                <small style="opacity:0.8;font-size:12px;">Venue ID: @item.MeetingVenueID</small>
              </div>
              <div class="d-flex gap-2 align-items-center">
                <a asp-action="MeetingVenueAddEdit" asp-controller="MeetingVenue"
                   asp-route-id="@item.MeetingVenueID"
                   title="Edit" style="color:#fff;font-size:18px;text-decoration:none;">✏️</a>
                <a asp-action="DeleteMeetingVenue" asp-controller="MeetingVenue"
                   asp-route-id="@item.MeetingVenueID"
                   title="Delete" style="color:#fff;font-size:18px;text-decoration:none;"
                   onclick="return confirm('Delete this venue?');">🗑</a>
              </div>
            </div>

            <!-- Card Body -->
            <div class="mom-venue-body">
              <div class="row g-3 mb-3">
                <div class="col-6">
                  <div style="background:#f9fafb;border-radius:14px;padding:16px;text-align:center;">
                    <div style="font-size:22px;font-weight:800;color:#4f46e5;">1</div>
                    <small style="color:#6b7280;font-size:12px;">Total Meetings</small>
                  </div>
                </div>
                <div class="col-6">
                  <div style="background:#f9fafb;border-radius:14px;padding:16px;text-align:center;">
                    <div style="font-size:22px;font-weight:800;color:#22c55e;">0</div>
                    <small style="color:#6b7280;font-size:12px;">Upcoming</small>
                  </div>
                </div>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <a href="#" style="color:#4f46e5;font-weight:500;font-size:13px;text-decoration:none;">
                  📅 View Schedule
                </a>
                <button class="mom-btn-save" style="font-size:12px;padding:7px 16px;" type="button">
                  + Schedule
                </button>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="mom-venue-footer">
              <span>Created</span>
              <span>@item.Created</span>
            </div>

          </div>
        </div>
      }
    </div>
  }
  else
  {
    <div class="mom-card">
      <div class="mom-card-body text-center py-5">
        <i class="bi bi-geo-alt fs-1 d-block mb-2 opacity-25"></i>
        <div class="mom-page-subtitle">No venues found. Add your first venue!</div>
      </div>
    </div>
  }

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById("venueSearch").addEventListener("keyup", function () {
  const value = this.value.toLowerCase();
  document.querySelectorAll(".venue-item").forEach(card => {
    card.style.display = card.innerText.toLowerCase().includes(value) ? "" : "none";
  });
});
</script>
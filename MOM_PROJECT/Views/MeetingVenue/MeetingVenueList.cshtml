@model List<MOM_PROJECT.Models.MeetingVenueModel>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>MOM – Meeting Venues</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

body{
  background: linear-gradient(135deg,#eef2ff,#f8fafc);
  font-family: "Inter", sans-serif;
}

/* HEADER */

.page-header{
  margin-bottom:32px;
}

.page-header h3{
  font-weight:800;
}

.page-header p{
  color:#6b7280;
}

/* SEARCH */

.search-card{
  background:#fff;
  border-radius:20px;
  box-shadow:0 12px 35px rgba(79,70,229,.12);
  padding:20px 24px;
  margin-bottom:30px;
  gap:20px;
  flex-wrap:wrap;
}

.search-card input{
  border-radius:12px;
  padding:10px 14px;
  border:1px solid #e5e7eb;
}

.search-card input:focus{
  box-shadow:0 0 0 3px rgba(99,102,241,.2);
  border-color:#6366f1;
}

/* VENUE CARD */

.venue-card{
  background:#fff;
  border-radius:22px;
  box-shadow:0 18px 45px rgba(79,70,229,.12);
  overflow:hidden;
  height:100%;
  display:flex;
  flex-direction:column;
  transition:.25s;
}

.venue-card:hover{
  transform:translateY(-6px);
  box-shadow:0 28px 60px rgba(79,70,229,.22);
}

/* HEADER */

.venue-header{
  background:linear-gradient(135deg,#6366f1,#8b5cf6);
  color:#fff;
  padding:18px 20px;
  display:flex;
  justify-content:space-between;
}

.venue-header h6{
  margin:0;
  font-weight:700;
}

.icon-actions span,
.icon-actions a{
  margin-left:12px;
  cursor:pointer;
  color:#fff;
}

/* BODY */

.venue-body{
  padding:22px;
  flex:1;
}

.stat-box{
  background:#f9fafb;
  border-radius:16px;
  padding:18px 10px;
  text-align:center;
}

.stat-box h4{
  margin:0;
  font-weight:700;
  color:#4f46e5;
}

.stat-box small{
  color:#6b7280;
}

.view-schedule{
  color:#4f46e5;
  text-decoration:none;
  font-weight:500;
}

.btn-schedule{
  background:#3f8f5a;
  color:#fff;
  border:none;
  border-radius:999px;
  padding:8px 20px;
  font-weight:600;
}

/* FOOTER */

.venue-footer{
  border-top:1px solid #eef2ff;
  padding:14px 20px;
  font-size:13px;
  color:#6b7280;
  display:flex;
  justify-content:space-between;
}

/* RESPONSIVE FIX */

@@media (max-width:992px){

  .search-card{
    flex-direction:column;
    align-items:stretch;
  }

  .search-card input{
    width:100% !important;
  }

}

@@media (max-width:576px){

  .venue-body{
    padding:18px;
  }

}

</style>
</head>

<body>

<div class="container-fluid mt-4">

<div class="page-header">
  <h3>Meeting Venues</h3>
  <p>Manage meeting rooms and virtual meeting locations</p>
</div>

<div class="search-card d-flex justify-content-between align-items-center">

  <input type="text"
         id="venueSearch"
         class="form-control w-50"
         placeholder="Search venues..." />

  <div class="text-muted">
    Total Venues: @(Model?.Count ?? 0)
  </div>

</div>

<!-- ✅ GRID — 3 CARDS PER ROW -->

<div class="row g-4" id="venueContainer">

@if (Model != null && Model.Count > 0)
{
  foreach (var item in Model)
  {
    <div class="col-lg-4 col-md-4 col-sm-6 venue-item">

      <div class="venue-card">

        <div class="venue-header">

          <div>
            <h6>@item.MeetingVenueName</h6>
            <small>📍 Venue ID: @item.MeetingVenueID</small>
          </div>

          <div class="icon-actions">
            <span>👁</span>
            <a asp-action="MeetingVenueAddEdit"
               asp-controller="MeetingVenue">✏️</a>
            <span>🗑</span>
          </div>

        </div>

        <div class="venue-body">

          <div class="row g-3 mb-3">

            <div class="col-6">
              <div class="stat-box">
                <h4>1</h4>
                <small>Total Meetings</small>
              </div>
            </div>

            <div class="col-6">
              <div class="stat-box">
                <h4>0</h4>
                <small>Upcoming</small>
              </div>
            </div>

          </div>

          <div class="d-flex justify-content-between">

            <a href="#" class="view-schedule">
              📅 View Schedule
            </a>

            <button class="btn-schedule">
              + Schedule
            </button>

          </div>

        </div>

        <div class="venue-footer">
          <span>Created</span>
          <span>@item.Created</span>
        </div>

      </div>

    </div>
  }
}

</div>
</div>

<script>

document.getElementById("venueSearch").addEventListener("keyup", function () {

  const value = this.value.toLowerCase();

  document.querySelectorAll(".venue-item").forEach(card => {

    card.style.display =
      card.innerText.toLowerCase().includes(value)
        ? ""
        : "none";

  });

});

</script>

</body>
</html>
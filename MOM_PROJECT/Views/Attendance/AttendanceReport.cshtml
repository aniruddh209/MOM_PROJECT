@model IEnumerable<MOM_PROJECT.Models.AttendanceReportModel>
@using MOM_PROJECT.Models

@{
    ViewData["Title"] = "Attendance Report";
    Layout = "_Layout";

    AttendanceSummaryModel summary =
        ViewBag.Summary as AttendanceSummaryModel ?? new AttendanceSummaryModel();
}

<style>
.page-title{font-size:28px;font-weight:700;}
.page-subtitle{color:#6b7280;}
.card{border:none;border-radius:16px;background:#fff;box-shadow:0 10px 25px rgba(0,0,0,0.08);}
.gradient-header{background:linear-gradient(135deg,#6a6ff5,#7b5cd6);color:#fff;border-radius:16px 16px 0 0;padding:14px 20px;font-weight:600;}
.form-control{border-radius:10px;}
.btn-purple{background:#4f46e5;color:#fff;border:none;}
.btn-purple:hover{background:#4338ca;color:#fff;}
.stat-card{padding:22px;}
.stat-label{font-size:13px;text-transform:uppercase;font-weight:600;}
.stat-value{font-size:24px;font-weight:700;}
.table th{background:#f1f3ff;color:#3730a3;font-weight:600;font-size:14px;}
.table td{font-size:14px;vertical-align:middle;}
.badge-present{background:#dcfce7;color:#166534;padding:6px 14px;border-radius:999px;font-weight:500;}
.badge-absent{background:#fee2e2;color:#991b1b;padding:6px 14px;border-radius:999px;font-weight:500;}
</style>

<div class="container-fluid px-4 mt-4">

<!-- ================= TITLE ================= -->
<div class="mb-4">
    <div class="page-title">Attendance Report</div>
    <div class="page-subtitle">Generate and export attendance reports</div>
</div>

<!-- ================= FILTER ================= -->
<div class="card mb-4">
    <div class="gradient-header">Report Filters</div>
    <div class="card-body">

        <div class="row g-3 align-items-end">

            <!-- GENERATE FORM -->
            <form asp-action="AttendanceReport" method="post" class="col-md-8 row g-3">
                <div class="col-md-6">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate"
                           value="@ViewBag.StartDate"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate"
                           value="@ViewBag.EndDate"
                           class="form-control" />
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-purple w-100">
                        Generate Report
                    </button>
                </div>
            </form>

            <!-- EXPORT FORM -->
            <form asp-action="ExportAttendance" method="post" class="col-md-4">
                <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                <input type="hidden" name="endDate" value="@ViewBag.EndDate" />

                <button type="submit" class="btn btn-success w-100">
                    Export Excel
                </button>
            </form>

        </div>
    </div>
</div>

<!-- ================= SUMMARY ================= -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-label text-primary">Total Records</div>
            <div class="stat-value">@summary.TotalRecords</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-label text-success">Present</div>
            <div class="stat-value">@summary.PresentCount</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-label text-warning">Attendance Rate</div>
            <div class="stat-value">@summary.AttendanceRate %</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card">
            <div class="stat-label text-info">Unique Meetings</div>
            <div class="stat-value">@summary.UniqueMeetings</div>
        </div>
    </div>
</div>

<!-- ================= TABLE ================= -->
<div class="card">
    <div class="gradient-header d-flex justify-content-between">
        <span>Attendance Data</span>
        <span class="badge bg-light text-dark">
            @(Model?.Count() ?? 0) records
        </span>
    </div>

    <div class="card-body p-0">
        <table class="table table-bordered mb-0">
            <thead>
                <tr>
                    <th>Meeting Date</th>
                    <th>Meeting Type</th>
                    <th>Venue</th>
                    <th>Department</th>
                    <th>Staff</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Remarks</th>
                </tr>
            </thead>

            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MeetingDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.MeetingTypeName</td>
                        <td>@item.MeetingVenueName</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.StaffName</td>
                        <td>@item.EmailAddress</td>
                        <td>
                            @if (item.IsPresent)
                            {
                                <span class="badge-present">Present</span>
                            }
                            else
                            {
                                <span class="badge-absent">Absent</span>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        No records found
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

</div>
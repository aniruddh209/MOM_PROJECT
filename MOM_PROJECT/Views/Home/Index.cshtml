@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<style>
.dashboard-title {
    font-size: 26px;
    font-weight: 700;
}
.dashboard-subtitle {
    color: #6b7280;
}

/* Welcome */
.welcome-alert {
    background:#dcfce7;
    border-left:5px solid #22c55e;
    padding:14px 18px;
    border-radius:12px;
    color:#166534;
    font-weight:500;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

/* Stat cards */
.stat-card {
    border-radius: 18px;
    padding: 22px;
    background: #fff;
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    position: relative;
    overflow:hidden;
}

.stat-card::before{
    content:"";
    position:absolute;
    left:0;
    top:0;
    height:100%;
    width:6px;
    background:#6366f1;
}

.card-green::before{ background:#22c55e; }
.card-blue::before{ background:#3b82f6; }
.card-orange::before{ background:#f59e0b; }

.stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    margin-bottom:12px;
}

.icon-purple { background:#6366f1; }
.icon-green { background:#22c55e; }
.icon-blue { background:#3b82f6; }
.icon-orange { background:#f59e0b; }

.stat-number { font-size:28px;font-weight:700; }
.stat-label { font-size:13px;text-transform:uppercase;color:#6b7280;font-weight:600; }

.stat-badge {
    display:inline-block;
    padding:4px 12px;
    font-size:12px;
    border-radius:999px;
    margin-top:10px;
}

.badge-success { background:#dcfce7;color:#166534; }
.badge-info { background:#e0f2fe;color:#075985; }
.badge-danger { background:#fee2e2;color:#991b1b; }

/* Charts */
.chart-card {
    background:#fff;
    border-radius:18px;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
    padding:20px;
}
.chart-header {
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-weight:600;
}
.chart-actions i {
    margin-left:10px;
    cursor:pointer;
    color:#6366f1;
}
</style>

<div class="container-fluid px-4 mt-4">

    <!-- ✅ WELCOME (DYNAMIC USER NAME) -->
    <div class="welcome-alert mb-4">
        <div>
            ✅ Welcome back Aniruddh,
            <strong>@User.Identity?.Name</strong>
        </div>
        <i class="bi bi-x"></i>
    </div>

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="dashboard-title">Dashboard</div>
            <div class="dashboard-subtitle">
                Meeting management overview and analytics
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
            <button class="btn btn-success">
                <i class="bi bi-download"></i> Export Report
            </button>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon icon-purple">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div class="stat-number">15</div>
                <div class="stat-label">Total Meetings</div>
                <span class="stat-badge badge-success">
                    ↑ 12% from last month
                </span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card card-green" style="background:#ecfdf5;">
                <div class="stat-icon icon-green">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="stat-number">0</div>
                <div class="stat-label">Upcoming</div>
                <span class="stat-badge badge-success">
                    ↑ 8% from last week
                </span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card card-blue" style="background:#eff6ff;">
                <div class="stat-icon icon-blue">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-number">10</div>
                <div class="stat-label">Completed</div>
                <span class="stat-badge badge-info">
                    ↑ 15% completion rate
                </span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card card-orange" style="background:#fffbeb;">
                <div class="stat-icon icon-orange">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div class="stat-number">5</div>
                <div class="stat-label">Cancelled</div>
                <span class="stat-badge badge-danger">
                    ↓ 3% cancellation rate
                </span>
            </div>
        </div>

    </div>

    <!-- CHARTS -->
    <div class="row g-4">

        <div class="col-md-6">
            <div class="chart-card">
                <div class="chart-header">
                    Meetings by Type
                    <div class="chart-actions">
                        <i class="bi bi-arrow-clockwise"></i>
                        <i class="bi bi-download"></i>
                    </div>
                </div>
                <canvas id="meetingTypeChart" height="260"></canvas>
            </div>
        </div>

        <div class="col-md-6">
            <div class="chart-card">
                <div class="chart-header">
                    Meetings by Department
                    <div class="chart-actions">
                        <i class="bi bi-arrow-clockwise"></i>
                        <i class="bi bi-download"></i>
                    </div>
                </div>
                <canvas id="departmentChart" height="260"></canvas>
            </div>
        </div>

    </div>

</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
/* Donut Chart */
new Chart(document.getElementById('meetingTypeChart'), {
    type: 'doughnut',
    data: {
        labels: ['Review', 'Planning', 'Scrum', 'Retrospective'],
        datasets: [{
            data: [4,5,3,3],
            backgroundColor: ['#6366f1','#22c55e','#3b82f6','#f59e0b']
        }]
    },
    options: {
        plugins:{ legend:{ position:'top' } },
        cutout:'65%'
    }
});

/* Bar Chart */
new Chart(document.getElementById('departmentChart'), {
    type:'bar',
    data:{
        labels:['IT','HR','Finance','Marketing'],
        datasets:[{
            label:'Number of Meetings',
            data:[5,3,4,2],
            backgroundColor:'#6366f1'
        }]
    },
    options:{
        scales:{ y:{ beginAtZero:true } }
    }
});
</script>